# Copy this file to .env and fill in real values. Never commit .env itself.

DATABASE_HOSTNAME=localhost
DATABASE_PORT=5432
DATABASE_PASSWORD=changeme
DATABASE_NAME=crud_db
DATABASE_USERNAME=postgres

SECRET_KEY=change-me-to-a-random-64-char-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTE=3000

CORS_ORIGINS=http://localhost:3000,http://localhost:5173

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# App password from your email provider, not your account password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=your-email@example.com
EMAIL_PASSWORD=your-app-password

# -------------------------
# Elasticsearch (optional — leave ELASTICSEARCH_HOST unset to disable search)
# -------------------------
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_SCHEME=https
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=changeme
ELASTICSEARCH_VERIFY_CERTS=False

# -------------------------
# Media storage: "disk" for local dev, "cloudinary" for deployed environments
# -------------------------
STORAGE_BACKEND=disk
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
